# Tabayyun configuration. Copy to .env and fill in what you have. Nothing here is required:
# without any LLM key the app runs in lexical-only mode (verbatim verses and hadith still verified).

# --- LLM providers: Anthropic is primary, OpenAI is the automatic fallback -------------------
ANTHROPIC_API_KEY=
# Any Claude model id. claude-opus-5 is the default; claude-sonnet-5 or claude-haiku-4-5 cost less.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — reasoning depth vs. latency for claim extraction.
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Speech-to-text ---------------------------------------------------------------------------
# auto: platform captions -> OpenAI transcription (needs OPENAI_API_KEY) -> local faster-whisper
# (only if installed with `pip install -e '.[whisper]'`).
TRANSCRIPTION_PROVIDER=auto
OPENAI_TRANSCRIBE_MODEL=whisper-1
LOCAL_WHISPER_MODEL=small

# --- Sources ----------------------------------------------------------------------------------
# Scholars' gradings from Dorar.net (live calls, cached on disk).
DORAR_ENABLED=true

# --- Limits -----------------------------------------------------------------------------------
MAX_TEXT_CHARS=60000
MAX_UPLOAD_MB=50
MAX_MEDIA_MINUTES=30

# --- Demo content -----------------------------------------------------------------------------
# A public YouTube link offered as the "video" example on the first screen (hidden when empty).
# Pick a short clip that has Arabic captions so the demo is instant, and make sure you are happy
# to link to it publicly. One that worked during development (3 minutes, human captions):
#   https://www.youtube.com/watch?v=ObnvFG3KcLs
EXAMPLE_VIDEO_URL=

# --- Deployment -------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from another host (empty = same-origin only).
CORS_ORIGINS=
LOG_LEVEL=INFO
