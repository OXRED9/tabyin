# Tabayyun configuration. Copy to .env, or run:  backend/.venv/bin/python scripts/set_openrouter_key.py
# Without a key the app runs in lexical-only mode (verbatim verses and narrations are still verified).

# --- Models: every call goes through OpenRouter with one key ----------------------------------
LLM_PROVIDER=openrouter
# Never commit a key. scripts/set_openrouter_key.py prompts for it, validates it and writes .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer (your public URL) and X-Title, so the calls are attributed to this app.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Tabayyun

# One model per task. IDs and prices were read from the live catalog on 3 Oct 2026 and measured with
# scripts/check_models.py, eval/bakeoff_extract.py and eval/ocr_exactness.py (see docs/DECISIONS.md).
# Extraction + pointing at retrieved texts: tied for best accuracy in the bake-off (85%) at the lowest cost — about $0.0012 per 5k-in/1k-out request.
MODEL_EXTRACT=qwen/qwen3.8-flash
# Reading images exactly as written: cheapest candidate, never "corrected" an altered verse (8/10 exact) — about $0.00006 per image.
MODEL_VISION=qwen/qwen3.7-flash
# Speech to timestamped segments: PROVISIONAL, not yet measured (audio calls need a funded balance) — list price $0.30 in / $2.50 out per million tokens.
MODEL_AUDIO=google/gemini-3.5-flash-lite
# One-line topic summaries and build-time chores: cheapest paid text model that passed the check — about $0.0002 per request.
MODEL_CHEAP=deepseek/deepseek-v4-flash
# Used when the primary fails twice or the daily limit is reached: free, a different family, text only — $0. Its pointing never yields "supported".
MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
# The "general chatbot without retrieval" baseline in eval/run.py: a mid-tier general model — about $0.10 per 79-item run.
MODEL_BASELINE_LLM=openai/gpt-6.1-sol
# Reasoning depth for models that reason before answering: none | minimal | low | medium | high.
LLM_REASONING_EFFORT=low
# Beyond this amount in one UTC day every call uses MODEL_FALLBACK (and the UI says coverage is reduced).
# 1 USD is roughly 800 verifications with the models above; raise it only with a budget to match.
DAILY_SPEND_LIMIT_USD=1

# --- Embeddings: local, never through OpenRouter (for the "authentic alternatives" feature) ----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Speech-to-text ---------------------------------------------------------------------------
# auto: platform captions -> MODEL_AUDIO -> local faster-whisper (only if installed with
# `pip install -e '.[whisper]'`). Recordings longer than AUDIO_CHUNK_SECONDS are split.
TRANSCRIPTION_PROVIDER=auto
AUDIO_CHUNK_SECONDS=600
LOCAL_WHISPER_MODEL=small

# --- Sources ----------------------------------------------------------------------------------
# Scholars' gradings from Dorar.net (live calls, cached on disk).
DORAR_ENABLED=true

# --- Limits -----------------------------------------------------------------------------------
MAX_TEXT_CHARS=60000
MAX_UPLOAD_MB=50
MAX_MEDIA_MINUTES=30

# --- Demo content -----------------------------------------------------------------------------
# A public YouTube link offered as the "video" example on the first screen (hidden when empty).
# Pick a short clip that has Arabic captions so the demo is instant, and make sure you are happy
# to link to it publicly. One that worked during development (3 minutes, human captions):
#   https://www.youtube.com/watch?v=ObnvFG3KcLs
EXAMPLE_VIDEO_URL=

# --- Deployment -------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from another host (empty = same-origin only).
CORS_ORIGINS=
LOG_LEVEL=INFO
# true enables /admin/usage (per-model cost summary; holds no user content). Keep false in production.
DEV_MODE=false

# --- Phase 2 features (set to false to switch one off) ---------------------------------------
FEATURES_SHARE_CARD=true   # shareable verdict card (PNG)
FEATURES_COPY=true         # one-click copy of the source's wording
FEATURES_EXPLAIN=true      # "why this verdict?" panel
# Public base URL of the deployment; printed and QR-encoded on verdict cards.
PUBLIC_URL=
